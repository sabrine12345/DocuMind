# DocuMind environment configuration
# Copy this file to .env and replace every "change-me" value.
# .env must never be committed (see .gitignore).

# --- PostgreSQL --------------------------------------------------------------
DB_NAME=documind
DB_USERNAME=documind
DB_PASSWORD=change-me-postgres
DB_PORT=5432

# --- MinIO (S3 compatible storage) -------------------------------------------
MINIO_ACCESS_KEY=documind
MINIO_SECRET_KEY=change-me-minio
MINIO_BUCKET=documind
MINIO_IMAGE=bitnamilegacy/minio:latest
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USERNAME=documind
RABBITMQ_PASSWORD=change-me-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_CONSOLE_PORT=15672

# --- Backend -----------------------------------------------------------------
# HMAC secret used to sign JWTs: at least 32 characters, generated randomly.
JWT_SECRET=change-me-with-a-random-secret-of-at-least-32-chars
BACKEND_PORT=8080
DOCUMIND_CORS_ORIGINS=http://localhost:4200

# --- Frontend ----------------------------------------------------------------
# Host port for the Angular container (nginx proxies /api to the backend).
FRONTEND_PORT=4200
